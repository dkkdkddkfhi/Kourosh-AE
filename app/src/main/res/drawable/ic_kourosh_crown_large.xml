<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!--
      The expanded notification's badge: the crest crown in gold on the app's own
      black plate, drawn at 96dp so it stays sharp on every density. The notification
      draws this into a circle already (see buildLargeIcon), so the plate is a plain
      disc and no corner geometry is needed here.

      Same crown geometry as ic_kourosh_notification, scaled 2.4x about its own 24x24
      centre and lifted 4dp, so the two icons are recognisably one mark at two sizes.
    -->
    <path
        android:fillColor="#FF0B0A08"
        android:pathData="M0,48 A48,48 0 1,1 96,48 A48,48 0 1,1 0,48 Z" />
    <group
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="19.2"
        android:translateY="16">
        <path
            android:fillColor="#FFD9A93B"
            android:pathData="M4,15.2 L6.4,7.4 L9,12.6 L12,4.8 L15,12.6 L17.6,7.4 L20,15.2 Z
                              M4.2,16.5 L19.8,16.5 L19.8,19.1 A0.9,0.9 0 0,1 18.9,20 L5.1,20 A0.9,0.9 0 0,1 4.2,19.1 Z
                              M12,2.4 A1,1 0 1,1 12,4.4 A1,1 0 1,1 12,2.4 Z
