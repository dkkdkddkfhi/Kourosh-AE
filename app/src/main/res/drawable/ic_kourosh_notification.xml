<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      A crown, and nothing else. The previous mark stacked a crown on a shield on a
      lit core at 24dp: three ideas in a space that fits one, so at status-bar size it
      read as a smudge. This is a single royal crown — five points, a bezel band under
      them, and a pearl on the three tall points.

      One white silhouette: the status bar tints it (Notification.setColor) and the
      quick-settings tile tints it too, so it must ship alpha-only. Subpaths are
      deliberately disjoint — the pearls float just clear of the points rather than
      sitting on them — because overlapping subpaths under evenOdd punch holes, and
      under nonZero the gems would vanish into the band.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,15.2 L6.4,7.4 L9,12.6 L12,4.8 L15,12.6 L17.6,7.4 L20,15.2 Z
                          M4.2,16.5 L19.8,16.5 L19.8,19.1 A0.9,0.9 0 0,1 18.9,20 L5.1,20 A0.9,0.9 0 0,1 4.2,19.1 Z
                          M12,2.4 A1,1 0 1,1 12,4.4 A1,1 0 1,1 12,2.4 Z
                          M6.4,5.1 A1,1 0 1,1 6.4,7.1 A1,1 0 1,1 6.4,5.1 Z
                          M17.6,5.1 A1,1 0 1,1 17.6,7.1 A1,1 0 1,1 17.6,5.1 Z" />
</vector>
